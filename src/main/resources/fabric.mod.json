{
  "schemaVersion": 1,
  "id": "balancedstacksizes",
  "version": "${version}",
  "name": "Balanced Stack Sizes - 26.3 Port",
  "description": "An unofficial Minecraft 26.3 port of HB0P's configurable item stack size mod.",
  "authors": ["HBOP"],
  "contributors": ["TheRonGDD (Minecraft 26.2 and 26.3 ports)"],
  "contact": {
    "homepage": "https://github.com/TheRonGDD/Resizable-Stacks",
    "sources": "https://github.com/TheRonGDD/Resizable-Stacks",
    "issues": "https://github.com/TheRonGDD/Resizable-Stacks/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.hbop.resizablestacks.ResizableStacks"
    ]
  },
  "mixins": [
    "resizablestacks.mixins.json",
    {
      "config": "resizablestacks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
